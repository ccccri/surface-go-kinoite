--- a/drivers/nfc/nxp-nci/core.c
+++ b/drivers/nfc/nxp-nci/core.c
@@ -31,6 +31,18 @@
 #define NXP_NCI_RF_PLL_UNLOCKED_NTF nci_opcode_pack(NCI_GID_RF_MGMT, 0x21)
 #define NXP_NCI_RF_TXLDO_ERROR_NTF nci_opcode_pack(NCI_GID_RF_MGMT, 0x23)
 
+/*
+ * NCI discovery parameter TOTAL_DURATION (id 0x00, 2 octets little endian, milliseconds): time
+ * between the starts of two polling cycles. The NCI default is 1000 ms, so a tag that is put on
+ * the reader can wait up to a second before it is noticed. Lower values detect faster and keep the
+ * RF field on more often (more power).
+ */
+#define NXP_NCI_PARAM_TOTAL_DURATION 0x00
+
+static unsigned int poll_period_ms = 250;
+module_param(poll_period_ms, uint, 0444);
+MODULE_PARM_DESC(poll_period_ms, "NFC polling period in ms (NCI TOTAL_DURATION), 0 keeps the chip default");
+
 static int nxp_nci_open(struct nci_dev *ndev)
 {
 	struct nxp_nci_info *info = nci_get_drvdata(ndev);
@@ -112,6 +124,26 @@
 	return 0;
 }
 
+static int nxp_nci_post_setup(struct nci_dev *ndev)
+{
+	__u8 val[2];
+	int r;
+
+	if (!poll_period_ms || poll_period_ms > 0xffff)
+		return 0;
+
+	val[0] = poll_period_ms & 0xff;
+	val[1] = (poll_period_ms >> 8) & 0xff;
+
+	r = nci_set_config(ndev, NXP_NCI_PARAM_TOTAL_DURATION, sizeof(val), val);
+	if (r)
+		nfc_err(&ndev->nfc_dev->dev, "could not set the poll period (%d)\n", r);
+	else
+		dev_info(&ndev->nfc_dev->dev, "poll period set to %u ms\n", poll_period_ms);
+
+	return 0;	/* not fatal: the chip keeps its default */
+}
+
 static const struct nci_driver_ops nxp_nci_core_ops[] = {
 	{
 		.opcode = NXP_NCI_RF_PLL_UNLOCKED_NTF,
@@ -127,6 +159,7 @@
 	.open = nxp_nci_open,
 	.close = nxp_nci_close,
 	.send = nxp_nci_send,
+	.post_setup = nxp_nci_post_setup,
 	.fw_download = nxp_nci_fw_download,
 	.core_ops = nxp_nci_core_ops,
 	.n_core_ops = ARRAY_SIZE(nxp_nci_core_ops),
