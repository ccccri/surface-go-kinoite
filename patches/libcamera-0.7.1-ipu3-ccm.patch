+		const long key = std::lround(1000.0 * std::log(bg / rg)) + 5000;
+		const Matrix<float, 3, 3> &m = ccms_.getInterpolated(static_cast<unsigned int>(std::max(0L, key)));
+
+		/* The ImgU takes signed fixed point values with 13 fractional bits (8192 = 1.0). */
+		auto q = [](float v) {
+			return static_cast<int16_t>(std::clamp<long>(std::lround(v * 8192.0f), -32768, 32767));
+		};
+		struct ipu3_uapi_ccm_mat_config &c = params->acc_param.ccm;
+		c.coeff_m11 = q(m[0][0]); c.coeff_m12 = q(m[0][1]); c.coeff_m13 = q(m[0][2]); c.coeff_o_r = 0;
