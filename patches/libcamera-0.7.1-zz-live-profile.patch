new file mode 100644
--- /dev/null
+++ b/include/libcamera/internal/live_profile.h
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Live camera profile of the Surface Linux suite
+ *
+ * Header-only, shared by the IPU3 pipeline handler and the IPU3 IPA (which run in different processes).
+ *
+ * <dir>/<sensor model>.profile   settings applied to every application (persistent)
+ * <dir>/<sensor model>.session   settings of one application: first line "pid <N>", ignored once process N is gone
+ *
+ * Both are text files, one "key value value ..." per line, '#' starts a comment. The session file wins over the profile.
+ * <dir> is $LIBCAMERA_SURFACE_PROFILE_DIR, else $XDG_CONFIG_HOME/surface-suite/camera, else $HOME/.config/surface-suite/camera.
+ * poll() looks at the files at most every 200 ms (modification time), so a change shows up within a fraction of a second.
+ */
+
+#pragma once
+
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <sys/stat.h>
+
+namespace libcamera {
+
+class LiveProfile
+{
+public:
+	explicit LiveProfile(const std::string &model)
+	{
+		const char *d = getenv("LIBCAMERA_SURFACE_PROFILE_DIR");
+		const char *x = getenv("XDG_CONFIG_HOME");
+		const char *h = getenv("HOME");
+		std::string dir;
+		if (d && *d)
+			dir = d;
+		else if (x && *x)
+			dir = std::string(x) + "/surface-suite/camera";
+		else if (h && *h)
+			dir = std::string(h) + "/.config/surface-suite/camera";
+		if (!dir.empty()) {
+			profilePath_ = dir + "/" + model + ".profile";
+			sessionPath_ = dir + "/" + model + ".session";
+		}
+		load();
+	}
+
+	/* Returns true when the settings changed since the last call. */
+	bool poll()
+	{
+		const auto now = std::chrono::steady_clock::now();
+		if (now - lastPoll_ < std::chrono::milliseconds(200))
+			return false;
+		lastPoll_ = now;
+		const long long sig = signature();
+		if (sig == signature_)
+			return false;
+		load();
+		return true;
+	}
+
+	bool has(const std::string &key) const { return values_.count(key) != 0; }
+
+	double number(const std::string &key, double def) const
+	{
+		auto it = values_.find(key);
+		return it == values_.end() || it->second.empty() ? def : it->second[0];
+	}
+
+	/* The values of a key, empty when absent. */
+	std::vector<double> list(const std::string &key) const
+	{
+		auto it = values_.find(key);
+		return it == values_.end() ? std::vector<double>() : it->second;
+	}
+
+private:
+	static long long mtime(const std::string &path)
+	{
+		struct stat st;
+		if (path.empty() || stat(path.c_str(), &st) != 0)
+			return 0;
+		return static_cast<long long>(st.st_mtim.tv_sec) * 1000000000LL + st.st_mtim.tv_nsec;
+	}
+
+	static bool alive(long pid)
+	{
+		struct stat st;
+		return pid > 0 && stat(("/proc/" + std::to_string(pid)).c_str(), &st) == 0;
+	}
+
+	/* Modification times of both files, plus whether the session owner is alive: any change means "reload". */
+	long long signature() const
+	{
+		return mtime(profilePath_) * 3 + mtime(sessionPath_) * 7 + (sessionAlive() ? 1 : 0);
+	}
+
+	bool sessionAlive() const
+	{
+		std::ifstream f(sessionPath_);
+		std::string word;
+		long pid = 0;
+		return f && (f >> word >> pid) && word == "pid" && alive(pid);
+	}
+
+	void parse(const std::string &path, bool session)
+	{
+		std::ifstream f(path);
+		std::string line;
+		bool first = true;
+		while (f && std::getline(f, line)) {
+			const size_t c = line.find('#');
+			if (c != std::string::npos)
+				line.resize(c);
+			std::istringstream in(line);
+			std::string key;
+			if (!(in >> key))
+				continue;
+			if (session && first) {
+				first = false;
+				if (key == "pid")
+					continue;
+			}
+			std::vector<double> v;
+			double n;
+			while (in >> n)
+				v.push_back(n);
+			values_[key] = v;
+		}
+	}
+
+	void load()
+	{
+		values_.clear();
+		signature_ = signature();
+		parse(profilePath_, false);
+		if (sessionAlive())
+			parse(sessionPath_, true);
+	}
+
+	std::string profilePath_;
+	std::string sessionPath_;
+	std::map<std::string, std::vector<double>> values_;
+	long long signature_ = -1;
+	std::chrono::steady_clock::time_point lastPoll_;
+};
+
+} /* namespace libcamera */
