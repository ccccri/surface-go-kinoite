+	r = nxp_nci_i2c_recv_retry(client, skb_put(*skb, header.plen), header.plen);
 	if (r < 0) {
 		goto nci_read_exit_free_skb;
 	} else if (r != header.plen) {
@@ -217,6 +234,13 @@
