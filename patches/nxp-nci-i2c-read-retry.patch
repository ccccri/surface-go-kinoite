--- a/drivers/nfc/nxp-nci/i2c.c
+++ b/drivers/nfc/nxp-nci/i2c.c
@@ -141,6 +141,23 @@
 	return r;
 }
 
+/*
+ * The controller sometimes NACKs a read although it asserted IRQ (it went back to standby, or the data
+ * was not ready yet). Retry a few times instead of treating it as fatal.
+ */
+static int nxp_nci_i2c_recv_retry(struct i2c_client *client, u8 *buf, int len)
+{
+	int r, retry;
+
+	r = i2c_master_recv(client, buf, len);
+	for (retry = 0; r == -EREMOTEIO && retry < 3; retry++) {
+		usleep_range(2000, 4000);
+		r = i2c_master_recv(client, buf, len);
+	}
+
+	return r;
+}
+
 static int nxp_nci_i2c_nci_read(struct nxp_nci_i2c_phy *phy,
 				struct sk_buff **skb)
 {
@@ -148,7 +165,7 @@
