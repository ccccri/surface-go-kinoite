 	int r;
 
-	r = i2c_master_recv(client, (u8 *) &header, NCI_CTRL_HDR_SIZE);
+	r = nxp_nci_i2c_recv_retry(client, (u8 *) &header, NCI_CTRL_HDR_SIZE);
 	if (r < 0) {
 		goto nci_read_exit;
 	} else if (r != NCI_CTRL_HDR_SIZE) {
@@ -168,7 +185,7 @@
