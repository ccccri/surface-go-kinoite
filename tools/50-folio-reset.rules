// Let the user at the console start the keyboard cover reset without a password (it only re-enumerates one USB device).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "folio-reset.service" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
