[Unit]
Description=Surface equalizer: apply the settings of the active output (speakers or headphone jack)
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service

[Service]
ExecStart=/usr/bin/python3 @GUIDE@/suite/control/audio_route.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
