 /**
+ * \brief Start a local search from the current lens position
+ * \param[in] context The shared IPA context
+ */
+void Af::afRescan(IPAContext &context)
+{
+	context.activeState.af.maxVariance = 0;
+	refVariance_ = 0.0;
+	refFrames_ = 0;
+	offFrames_ = 0;
+	rescan_ = false;
+	previousVariance_ = 0.0;
+	coarseCompleted_ = false;
+	fineCompleted_ = false;
+	coarseDrops_ = 0;
+	maxStep_ = kMaxFocusSteps;
+	context.activeState.af.stable = false;
+
+	local_ = true;
+	localPhase_ = LocalBase;
+	localStart_ = context.activeState.af.focus;
+	localHold_ = 0;
+	localAcc_ = 0.0;
+	localN_ = 0;
+	localCount_ = 0;
+	localVarUp_ = 0.0;
+	localVarDown_ = 0.0;
+	localFocus_ = localStart_;
+	localSamples_.clear();
+	/* The lens is already parked: measure it for a full hold. */
+	ignoreCounter_ = 0;
+}
+
+/**
+ * \brief End the local search and hand over to the fine scan
+ */
+void Af::afLocalDone(IPAContext &context, uint32_t best)
+{
+	/*
+	 * The climb is over (the sharpness was sampled every kLocalStep, so the real peak can be up to half of it
+	 * away from the best sample): measure kRefineCount positions kRefineStep apart centred on it. If the best of
+	 * them is at an end of the range the peak is further out, so measure again around that end.
+	 */
+	double est = best;
+	double l = -1.0, c = -1.0, r = -1.0;
+	for (const auto &p : localSamples_) {
+		if (p.first == static_cast<int64_t>(best))
+			c = std::max(c, p.second);
+		else if (p.first == static_cast<int64_t>(best) - kLocalStep)
+			l = p.second;
+		else if (p.first == static_cast<int64_t>(best) + kLocalStep)
+			r = p.second;
+	}
+	if (l >= 0.0 && r >= 0.0 && l - 2.0 * c + r < 0.0)
+		est = best + std::clamp(0.5 * (l - r) / (l - 2.0 * c + r), -1.0, 1.0) * kLocalStep;
+	best = static_cast<uint32_t>(std::clamp(est, 0.0, static_cast<double>(kMaxFocusSteps)));
+
+	localPhase_ = LocalRefine;
+	localBestFocus_ = best;
+	localRefineRounds_ = 0;
+	localSamples_.clear();
+	localHold_ = 0;
+	localAcc_ = 0.0;
+	localN_ = 0;
+	localRefineStart_ = std::max<int64_t>(0, static_cast<int64_t>(best) - (kRefineCount / 2) * kRefineStep);
+	localFocus_ = localRefineStart_;
+	context.activeState.af.focus = localFocus_;
+	focus_ = localFocus_;
+}
+
+/**
+ * \brief Place the sharpness peak with a parabola through the refinement samples and park the lens there
+ */
+void Af::afLocalFinish(IPAContext &context, uint32_t peakStep, double peakVar)
+{
+	local_ = false;
+	coarseCompleted_ = true;
+	fineCompleted_ = true;
+	bestFocus_ = peakStep;
+	focus_ = bestFocus_;
+	context.activeState.af.focus = bestFocus_;
+	context.activeState.af.maxVariance = peakVar;
+	context.activeState.af.stable = true;
+	previousVariance_ = 0;
+	refVariance_ = 0.0;
+	refFrames_ = 0;
+	offFrames_ = 0;
+	ignoreCounter_ = kIgnoreFrame;
+	LOG(IPU3Af, Debug) << "Local search ends at step " << bestFocus_ << " (coarse peak " << localBestFocus_ << ")";
+}
