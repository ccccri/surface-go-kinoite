+	localDir_ = localVarUp_ >= localVarDown_ ? 1 : -1;
+	localBestVar_ = std::max(localVarUp_, localVarDown_);
+	localBestFocus_ = localDir_ > 0 ? start + step : start - step;
+	localWorse_ = 0;
+	localCount_ = 0;
+	localPhase_ = LocalClimb;
+	const int64_t next = start + localDir_ * 2 * step;
+	if (next < 0 || next > top)
+		afLocalDone(context, localBestFocus_);
