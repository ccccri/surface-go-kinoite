+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ *
+ * The optional "black" list gives the black level of the Gr, R, B and Gb channels. The sensor adds a pedestal of its own
+ * to the data, different for every module (and per channel); subtracting more than that crushes the shadows.
+ *
+ * The optional "bnr" list [cf, cg, alpha, beta, gamma, max_inf] tunes the Bayer noise reduction that the Awb algorithm
+ * enables with the Intel defaults: cf is the constant part of the noise threshold (1700 in the defaults, up to 8191), cg makes the noise threshold grow with the analogue gain (0 in the defaults, so the
+ * filter does not get stronger in dim light), alpha/beta/gamma are the weights of the smoothing filter. It is applied
+ * after Awb, so this algorithm has to be listed after it.
+ */
+int BlackLevelCorrection::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	if (tuningData.contains("bnr")) {
+		const auto bnr = tuningData["bnr"].get<std::vector<unsigned int>>();
+		if (!bnr || bnr->size() != 6)
+			return -EINVAL;
+
+		for (unsigned int i = 0; i < 6; i++)
+			bnr_[i] = (*bnr)[i];
+		hasBnr_ = true;
+	}
+
+	if (!tuningData.contains("black"))
+		return 0;
+
+	const auto black = tuningData["black"].get<std::vector<unsigned int>>();
+	if (!black || black->size() != 4)
+		return -EINVAL;
+
+	for (unsigned int i = 0; i < 4; i++)
+		black_[i] = std::min<unsigned int>((*black)[i], 255);
+
+	return 0;
+}
